{
  "name": "lilycrest-server",
  "version": "1.0.0",
  "description": "Backend API for Lilycrest Dormitory Management",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=384 server.js",
    "dev": "nodemon server.js",
    "kill-port": "node scripts/kill-port.js",
    "restart": "node scripts/kill-port.js && node server.js",
    "billing:backfill-anniversary-rent": "node scripts/backfill_anniversary_rent_bills.mjs",
    "billing:backfill-anniversary-rent:write": "node scripts/backfill_anniversary_rent_bills.mjs --write",
    "reservation:backfill-codes": "node scripts/backfill_reservation_codes.mjs",
    "reservation:backfill-codes:write": "node scripts/backfill_reservation_codes.mjs --write",
    "reservation:audit-payment-integrity": "node scripts/audit_reservation_payment_integrity.mjs",
    "utility:repair-bill-cycles": "node scripts/repair_utility_only_bill_cycles.mjs",
    "utility:repair-bill-cycles:write": "node scripts/repair_utility_only_bill_cycles.mjs --write",
    "utility:diagnose": "node scripts/diagnose_utility_sync.mjs",
    "utility:repair": "node scripts/repair_utility_sync.mjs",
    "utility:cleanup-zero-segments": "node scripts/cleanup_zero_consumption_segments.mjs",
    "utility:cleanup-zero-segments:write": "node scripts/cleanup_zero_consumption_segments.mjs --write",
    "utility:repair-future-dates": "node scripts/repair_future_utility_period_dates.mjs",
    "utility:repair-future-dates:write": "node scripts/repair_future_utility_period_dates.mjs --write",
    "utility:migrate-lifecycle-indexes": "node scripts/migrate_utility_lifecycle_indexes.mjs",
    "push:repair-duplicates": "node scripts/repair_duplicate_push_registrations.mjs",
    "push:repair-duplicates:write": "node scripts/repair_duplicate_push_registrations.mjs --write",
    "maintenance:backfill-contract": "node scripts/backfill_maintenance_contract.mjs",
    "maintenance:backfill-contract:write": "node scripts/backfill_maintenance_contract.mjs --write",
    "tenant-onboarding:backfill": "node scripts/backfill_tenant_onboarding_seen.mjs",
    "tenant-onboarding:backfill:write": "node scripts/backfill_tenant_onboarding_seen.mjs --confirm",
    "maintenance:branch-report": "node scripts/repair_maintenance_branches.mjs",
    "maintenance:branch-repair": "node scripts/repair_maintenance_branches.mjs --write",
    "contracts:audit-prepared-documents": "node scripts/audit_broken_prepared_contracts.mjs",
    "contracts:audit-duplicates": "node scripts/audit_duplicate_contracts.mjs",
    "contracts:repair-target-movein-drafts": "node scripts/repair_contract_target_movein_drafts.mjs",
    "contracts:repair-target-movein-drafts:write": "node scripts/repair_contract_target_movein_drafts.mjs --write",
    "seed:analytics-demo": "node scripts/seed_analytics_demo.mjs",
    "seed:service-providers": "node scripts/seed_service_providers.mjs",
    "seed:service-providers:write": "node scripts/seed_service_providers.mjs --write",
    "qa:fixtures:status": "node scripts/qa_fixtures.mjs status",
    "qa:fixtures:seed": "node scripts/qa_fixtures.mjs seed",
    "qa:fixtures:reset": "node scripts/qa_fixtures.mjs reset",
    "qa:inboxes:bootstrap": "node scripts/qa_bootstrap_inboxes.mjs",
    "qa:inbox:device": "node scripts/qa_inbox_device.mjs",
    "qa:inbox:serve": "node scripts/qa_local_inbox_server.mjs",
    "qa:mongo": "node scripts/qa_mongo_server.mjs",
    "qa:runtime": "node scripts/qa_runtime_server.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --testPathIgnorePatterns=integration"
  },
  "keywords": [
    "express",
    "firebase",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sparticuz/chromium": "^143.0.4",
    "axios": "^1.16.0",
    "capstone-website": "file:..",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.1.0",
    "mongodb": "^7.2.0",
    "mongoose": "^8.22.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.59.1",
    "resend": "^6.12.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "tesseract.js": "^5.1.1",
    "uuid": "^13.0.0",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.0.1"
  }
}
