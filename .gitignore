# Dependencies
node_modules/
server/node_modules/
web/node_modules/

# Environment variables (secrets — never commit)
.env
*.env
.env.*
server/config/google-vision-key.json
# Allow deployment example templates
!*.example
!**/*.example

# Python venv
.venv/

# Build outputs
web/dist/
web/build/
web/build-admin/
web/*.pdf

# Runtime logs
.codex-run-logs/
*.log
coverage/
server/coverage/
web/coverage/

# Contract runtime data and generated inspection artifacts.
# Official immutable master templates are intentional runtime assets.
server/private/**
!server/private/contract-templates/
!server/private/contract-templates/**
server/scripts/render_contract_mask_debug.mjs

# Backups and database dumps
server/backups/*.gz
server/backups/*.json
server/backups/*.json.gz

# Editor / tool state
.claude/
.vscode/
.superpowers/

# Reproducible local water-fixture screenshots/PDFs; keep harness and audit notes.
/.water-visual-qa/screenshots/
/.water-visual-qa/*.png
/.water-visual-qa/*.pdf
/.water-visual-qa/premerge/*.png
/.water-visual-qa/premerge/*.pdf
/.water-visual-qa/premerge/*-runtime.txt
/.water-visual-qa/premerge/*-text.txt
/.water-visual-qa/premerge/frontend-unit-search.txt

